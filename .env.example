# GitHub API token (needs repo:read scope)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_token_here

# Anthropic API key (for synthetic instruction generation)
ANTHROPIC_API_KEY=your_api_key_here

# AWS credentials for SoftwareHeritage S3 access (used by stack_v2_download.py)
# Request access at: https://registry.opendata.aws/software-heritage/
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
